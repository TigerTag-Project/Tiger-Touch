# ---------------------------------------------------------------------------
# Tiger Touch - ignored paths
# ---------------------------------------------------------------------------

# Build output and downloaded components. Everything here is regenerated by
# one build; `dependencies.lock` is what pins the components, and is committed.
firmware/build/
firmware/managed_components/
firmware/sdkconfig
firmware/sdkconfig.old

# Internal working documents (French, bench reports, decisions in progress).
# NEVER published.
_internal/

# The factory image dumped from a board before the first flash. It is
# BigTreeTech's firmware, not ours, and it is 16 MB.
backup/
# Binaries are built by CI (a build artifact of every run, release assets of a
# tag); never committed. The site (installer + OTA manifest) is generated by
# .github/workflows/pages.yml from the release, never committed either.
*.bin
dist/
site/
installer/manifest.json
installer/version.json

# Local-only: terms that must never reach the repository (an address, a Wi-Fi
# name, a serial), read by scripts/check-private-data.py. Never committed.
.private-terms

# Local-only: the owner's own read of the whole history before a push. It is a
# personal pre-publication step, not part of the project.
scripts/audit-history.py

# Machine-local settings and bench tooling kept out of the tree on purpose.
.claude/settings.local.json
*.local.*
local/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc
.claude/scheduled_tasks.lock
